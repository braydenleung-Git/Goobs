generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ProviderConfig {
  id              String   @id @default("uuid")
  baseUrl         String   @default("http://homelab/bifrost/v1")
  encryptedApiKey String?
  keyIv           String?
  keyTag          String?
  keyVersion      Int?
  updatedAt       DateTime @updatedAt
}

model AgentProfile {
  id               String   @id @default("uuid")
  name             String
  systemPrompt     String
  skillsJson       String   @default("[]")
  toolsJson        String   @default("[]")
  defaultModel     String
  modelColorHex    String   @default("#4f46e5")
  prefersImageTasks Boolean @default(false)
  isPrebuilt       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WorkstationState {
  id            String   @id @default("uuid")
  workstationId String   @unique
  isUnlocked    Boolean  @default(false)
  unlockedAt    DateTime?
}

model ChallengeRun {
  id                  String   @id @default("uuid")
  challengeSlug       String
  agentId             String
  workstationId       String
  modelUsed           String
  runtimeStateLogJson String   @default("[]")
  outputText          String   @default("")
  toolCallsJson       String   @default("[]")
  artifactsJson       String   @default("[]")
  deterministicPass   Boolean  @default(false)
  rubricPass          Boolean  @default(false)
  finalPass           Boolean  @default(false)
  deterministicScore  Float    @default(0)
  rubricScore         Float    @default(0)
  totalScore          Float    @default(0)
  rationale           String   @default("")
  createdAt           DateTime @default(now())
}

model ProgressState {
  id                       String   @id @default("uuid")
  totalXp                  Int      @default(0)
  level                    Int      @default(1)
  unlockedItemsJson        String   @default("[]")
  unlockedWorkstationsJson String   @default("[]")
  updatedAt                DateTime @updatedAt
}

model ChallengeRewardEvent {
  id            String   @id @default("uuid")
  runId         String   @unique
  challengeSlug String
  xpAwarded     Int      @default(0)
  appliedAt     DateTime @default(now())
}
